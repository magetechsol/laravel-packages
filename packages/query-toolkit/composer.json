{
    "name": "magetech/laravel-query-toolkit",
    "description": "Enterprise-grade query builder for Laravel APIs with filtering, sorting, searching, pagination, and relationship support.",
    "keywords": ["laravel", "query-builder", "api", "filters", "sorting", "pagination", "search", "eloquent"],
    "homepage": "https://github.com/magetechsolutions/laravel-query-toolkit",
    "license": "MIT",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\QueryToolkit\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\QueryToolkit\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\QueryToolkit\\QueryToolkitServiceProvider"
            ],
            "aliases": {
                "MtsQuery": "MageTech\\QueryToolkit\\Support\\Facades\\MtsQuery"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "format-test": "vendor/bin/pint --test"
    }
}
