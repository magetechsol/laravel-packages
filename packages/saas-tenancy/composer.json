{
    "name": "magetech/laravel-saas-tenancy",
    "description": "Multi-tenant architecture for Laravel SaaS applications.",
    "keywords": ["laravel", "saas", "tenancy", "multi-tenant", "isolation"],
    "homepage": "https://github.com/magetechsol/laravel-packages/tree/main/packages/saas-tenancy",
    "license": "MIT",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\SaaSTenancy\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\SaaSTenancy\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\SaaSTenancy\\SaaSTenancyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
