{
    "name": "magetech/laravel-saas-tenancy",
    "description": "Multi-tenant architecture for Laravel SaaS applications — shared database or database-per-tenant with zero code changes to switch strategies.",
    "keywords": ["laravel", "saas", "tenancy", "multi-tenant", "multi-tenancy", "tenant", "database", "isolation"],
    "homepage": "https://github.com/magetechsol/laravel-saas-tenancy",
    "license": "MIT",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.0|^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\SaaS\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\SaaS\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\SaaS\\SaaSTenancyServiceProvider"
            ],
            "aliases": {
                "Tenant": "MageTech\\SaaS\\Support\\Facades\\Tenant"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint",
        "format-test": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
