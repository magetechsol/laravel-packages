{
    "name": "magetech/laravel-feature-flags",
    "version": "1.0.0",
    "description": "Controlled feature rollout and feature management for Laravel.",
    "keywords": ["laravel", "feature-flags", "rollout", "release", "toggle", "targeting"],
    "homepage": "https://github.com/magetechsol/laravel-packages/tree/main/packages/feature-flags",
    "license": "MIT",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.0|^3.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\FeatureFlags\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\FeatureFlags\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\FeatureFlags\\FeatureFlagsServiceProvider"
            ],
            "aliases": {
                "Feature": "MageTech\\FeatureFlags\\Facades\\Feature"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint",
        "format-test": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
