{
    "name": "magetech/laravel-api-toolkit",
    "description": "Standardized enterprise API responses, errors and API architecture for Laravel.",
    "keywords": ["laravel", "api", "responses", "errors", "enterprise"],
    "homepage": "https://github.com/magetechsol/laravel-packages/tree/main/packages/api-toolkit",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\ApiToolkit\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\ApiToolkit\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\ApiToolkit\\ApiToolkitServiceProvider"
            ],
            "aliases": {
                "ApiResponse": "MageTech\\ApiToolkit\\Support\\Facades\\ApiResponse"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint",
        "format-test": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
