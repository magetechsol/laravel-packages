{
    "name": "magetech/laravel-webhooks",
    "description": "Enterprise-grade inbound and outbound webhook infrastructure for Laravel.",
    "keywords": ["laravel", "webhooks", "events", "integrations", "stripe", "razorpay", "shopify", "magento"],
    "homepage": "https://github.com/magetechsol/laravel-packages/tree/main/packages/webhooks",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\Webhooks\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\Webhooks\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\Webhooks\\WebhooksServiceProvider"
            ],
            "aliases": {
                "Webhook": "MageTech\\Webhooks\\Support\\Facades\\Webhook",
                "WebhookEvent": "MageTech\\Webhooks\\Support\\Facades\\WebhookEvent"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint",
        "format-test": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
