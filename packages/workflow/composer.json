{
    "name": "magetech/laravel-workflow",
    "description": "Enterprise workflow engine and approval automation for Laravel.",
    "keywords": ["laravel", "workflow", "automation", "approval", "business", "state-machine", "erp", "crm"],
    "homepage": "https://github.com/magetechsol/laravel-packages/tree/main/packages/workflow",
    "license": "MIT",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/bus": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.0|^3.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\Workflow\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\Workflow\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\Workflow\\WorkflowServiceProvider"
            ],
            "aliases": {
                "Workflow": "MageTech\\Workflow\\Support\\Facades\\Workflow"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint",
        "format-test": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
