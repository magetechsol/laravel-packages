{
    "name": "magetech/laravel-import-export",
    "description": "Large-scale CSV/XLSX import and export processing for Laravel.",
    "keywords": ["laravel", "import", "export", "csv", "xlsx", "excel"],
    "homepage": "https://github.com/magetechsol/laravel-packages/tree/main/packages/import-export",
    "license": "MIT",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\ImportExport\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\ImportExport\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\ImportExport\\ImportExportServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
