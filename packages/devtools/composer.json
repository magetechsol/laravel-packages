{
    "name": "magetech/laravel-devtools",
    "description": "Local-only Laravel developer dashboard and diagnostic toolkit — application info, performance metrics, security audit, package status, and artisan commands.",
    "keywords": ["laravel", "devtools", "debug", "diagnostics", "development", "dashboard", "performance", "security"],
    "homepage": "https://github.com/magetechsol/laravel-packages/tree/main/packages/devtools",
    "license": "MIT",
    "authors": [
        {
            "name": "MageTech Solutions",
            "email": "dev@magetechsolutions.com"
        }
    ],
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.0|^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MageTech\\DevTools\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageTech\\DevTools\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MageTech\\DevTools\\DevToolsServiceProvider"
            ],
            "aliases": {
                "DevTools": "MageTech\\DevTools\\Support\\Facades\\DevToolsFacade"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint",
        "format-test": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
